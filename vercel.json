{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/r/(.*)", "destination": "/api/index.js" },
    { "source": "/app", "destination": "/public/index.html" },
    { "source": "/dashboard", "destination": "/public/index.html" },
    { "source": "/cockpit", "destination": "/public/index.html" },
    { "source": "/slides", "destination": "/public/pitch-deck.html" },
    { "source": "/pitch-deck", "destination": "/public/pitch-deck.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
